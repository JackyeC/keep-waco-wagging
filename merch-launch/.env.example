# Merch launch — add real values to merch-launch/.env (never commit secrets)

# Printify (required for draft creation and live margin lookup)
# Live draft creation requires token scopes: shops.read, catalog.read,
# print_providers.read, products.read, products.write, uploads.read, uploads.write
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Shopify Admin API (required for draft export / publish — not used by public storefront fetch)
# Shopify Admin API — Dev Dashboard app (kww)
SHOPIFY_STORE_DOMAIN=keepwacowagging.myshopify.com
# Preferred: client credentials (fresh in-memory token; never commit values)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Legacy fallback only (optional)
SHOPIFY_ACCESS_TOKEN=

# Etsy Open API v3 (required for Etsy listing drafts)
ETSY_SHOP_ID=
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REFRESH_TOKEN=

# Safety defaults — scripts refuse to mutate stores unless explicitly overridden
DRY_RUN=true

# Optional: scan additional artwork folders (colon-separated absolute paths)
ARTWORK_SEARCH_PATHS=
